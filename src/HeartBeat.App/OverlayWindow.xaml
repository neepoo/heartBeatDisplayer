<Window x:Class="HeartBeat.App.OverlayWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:HeartBeat.App"
  Title="HeartBeat · 心率悬浮窗" Width="{x:Static local:OverlayLayout.DefaultWidth}" Height="{x:Static local:OverlayLayout.DefaultHeight}" MinWidth="{x:Static local:OverlayLayout.MinimumWidth}" MinHeight="{x:Static local:OverlayLayout.MinimumHeight}" MaxWidth="{x:Static local:OverlayLayout.MaximumWidth}" MaxHeight="{x:Static local:OverlayLayout.MaximumHeight}" WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False" UseLayoutRounding="True">
  <Border x:Name="Card" CornerRadius="13" BorderBrush="#35465268" BorderThickness="1" Padding="14,10,14,12" MouseLeftButtonDown="DragCard">
    <Border.Background><SolidColorBrush Color="#111722" Opacity="0.8"/></Border.Background>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition x:Name="ReadingRow" Height="62"/><RowDefinition Height="*"/><RowDefinition x:Name="StatisticsRow" Height="42"/></Grid.RowDefinitions>
      <Grid Grid.Row="0">
        <TextBlock x:Name="TitleLabel" Text="HEARTBEAT" Foreground="#A7B4C7" FontSize="10" VerticalAlignment="Center"/>
        <TextBlock x:Name="ModeLabel" Text="拖动边缘缩放" Foreground="#7F8B9E" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
      <Grid Grid.Row="1">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Grid x:Name="PulseHost" Width="36" Height="36" Margin="0,0,9,0" VerticalAlignment="Center" ToolTip="心跳动效按当前 BPM 推算节奏">
            <Grid x:Name="PulseVisual" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform><ScaleTransform x:Name="PulseScale" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
              <Ellipse Fill="#20FB7185"/>
              <Path Margin="5" Fill="#FB7185" Stretch="Uniform" Data="M12,21 C10,19 2,14 2,8 C2,3 8,1 12,6 C16,1 22,3 22,8 C22,14 14,19 12,21 Z"/>
            </Grid>
          </Grid>
          <TextBlock x:Name="BpmLabel" Text="--" Foreground="#F4F7FC" FontFamily="Segoe UI" FontSize="48" FontWeight="SemiBold"/>
          <TextBlock x:Name="UnitLabel" Text="BPM" Foreground="#8795A9" FontSize="10" Margin="7,29,0,0"/>
        </StackPanel>
        <TextBlock x:Name="StatusLabel" Text="未连接" Foreground="#9AA7BA" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="80" TextTrimming="CharacterEllipsis"/>
      </Grid>
      <local:HeartRateChart Grid.Row="2" x:Name="Chart" Margin="0,4,0,6"/>
      <Border Grid.Row="3" BorderBrush="#30465268" BorderThickness="0,1,0,0" Padding="0,7,0,0" ToolTip="最近 5 分钟内收到的有效心率样本统计">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="5分钟均值" FontSize="9" Foreground="#8492A7"/><TextBlock x:Name="AverageLabel" Text="--" FontSize="16" FontWeight="SemiBold" Foreground="#EDF1F7"/></StackPanel>
          <StackPanel Grid.Column="1" HorizontalAlignment="Center"><TextBlock Text="最低" FontSize="9" Foreground="#8492A7"/><TextBlock x:Name="MinimumLabel" Text="--" FontSize="16" FontWeight="SemiBold" Foreground="#A8D7CE"/></StackPanel>
          <StackPanel Grid.Column="2" HorizontalAlignment="Right" Margin="0,0,8,0"><TextBlock Text="最高" FontSize="9" Foreground="#8492A7"/><TextBlock x:Name="MaximumLabel" Text="--" FontSize="16" FontWeight="SemiBold" Foreground="#FDB1BB"/></StackPanel>
        </Grid>
      </Border>
      <Path x:Name="ResizeGrip" Grid.RowSpan="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-8,-6" Stroke="#8795A9" StrokeThickness="1" Data="M0,10 L10,0 M5,10 L10,5" IsHitTestVisible="False"/>
    </Grid>
  </Border>
</Window>
