<Window x:Class="HeartBeat.App.ControlWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="HeartBeat · 连接与设置" Width="500" Height="675" MinWidth="460" MinHeight="550" Background="#10141C" Foreground="#EDF1F7" WindowStartupLocation="CenterScreen">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,24,28,20">
      <TextBlock Text="♥  HEARTBEAT" Foreground="#FB7185" FontSize="12" FontWeight="SemiBold"/>
      <TextBlock Text="连接你的手表" FontSize="28" FontWeight="SemiBold" Margin="0,10,0,5"/>
      <TextBlock Text="Forerunner 255 · 实时心率悬浮窗" Foreground="#93A0B5" Margin="0,0,0,18"/>
      <Border Background="#1A202C" CornerRadius="10" Padding="16" Margin="0,0,0,18">
        <StackPanel>
          <TextBlock Text="先在手表上开启心率广播" FontWeight="SemiBold" Margin="0,0,0,7"/>
          <TextBlock Text="长按 UP → 腕式心率 → 广播心率 → START。部分固件的“腕式心率”位于健康相关菜单内。" Foreground="#A5B1C3" TextWrapping="Wrap" LineHeight="21"/>
          <TextBlock Text="电脑开启蓝牙，手表保持在附近。游戏使用无边框模式。" Foreground="#A5B1C3" TextWrapping="Wrap" Margin="0,7,0,0" LineHeight="21"/>
        </StackPanel>
      </Border>
      <Grid Margin="0,0,0,9"><TextBlock Text="附近的心率设备" FontWeight="SemiBold"/><TextBlock x:Name="DeviceCount" Foreground="#8492A7" HorizontalAlignment="Right"/></Grid>
      <ListBox x:Name="DeviceList" Height="94" Background="#171D28" Foreground="#ECF1F9" BorderBrush="#2C3546" DisplayMemberPath="Name" Padding="5" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="附近的心率设备"/>
      <Grid Margin="0,10,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Button x:Name="ScanButton" Content="扫描设备" Click="ScanClick" Margin="0,0,8,0"/>
        <Button x:Name="ConnectButton" Grid.Column="1" Content="连接" Click="ConnectClick" Background="#FB7185" Foreground="#171B24" Margin="0,0,8,0"/>
        <Button x:Name="DisconnectButton" Grid.Column="2" Content="断开" Click="DisconnectClick"/>
      </Grid>
      <TextBlock x:Name="ConnectionLabel" Foreground="#A5B1C3" Text="尚未连接" Margin="0,10,0,0" TextWrapping="Wrap"/>
      <TextBlock x:Name="MessageLabel" Foreground="#FBBF82" Margin="0,5,0,0" TextWrapping="Wrap"/>
      <Border Background="#2C3546" Height="1" Margin="0,17,0,17"/>
      <Grid><TextBlock Text="悬浮窗" FontWeight="SemiBold"/><Button Content="显示 / 隐藏" Click="VisibilityClick" HorizontalAlignment="Right" Padding="10,5" FontSize="11"/></Grid>
      <CheckBox x:Name="LockCheck" Content="锁定位置并开启鼠标穿透" Foreground="#CFD7E5" Margin="0,12,0,12" Checked="LockChanged" Unchecked="LockChanged"/>
      <TextBlock Text="解锁后拖动窗口边缘或右下角缩放，大小会自动保存。" FontSize="11" Foreground="#8290A5" TextWrapping="Wrap" Margin="0,0,0,10"/>
      <CheckBox x:Name="AnimationCheck" Content="心跳动效（节奏按 BPM 推算）" Foreground="#CFD7E5" Margin="0,0,0,12" Checked="AnimationChanged" Unchecked="AnimationChanged"/>
      <Grid><TextBlock Text="背景不透明度" Foreground="#A5B1C3"/><TextBlock x:Name="OpacityLabel" Text="80%" HorizontalAlignment="Right" Foreground="#A5B1C3"/></Grid>
      <Slider x:Name="OpacitySlider" Minimum="40" Maximum="95" Value="80" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,8,0,10" ValueChanged="OpacityChanged" AutomationProperties.Name="背景不透明度"/>
      <TextBlock Text="Ctrl + Alt + H  显示 / 隐藏      Ctrl + Alt + L  锁定 / 解锁" FontSize="11" Foreground="#8290A5" TextWrapping="Wrap"/>
      <TextBlock Text="关闭此窗口后，仍可从系统托盘打开设置或退出。" FontSize="11" Foreground="#8290A5" Margin="0,7,0,16"/>
      <Button x:Name="DemoButton" Content="试用模拟数据" Click="DemoClick" HorizontalAlignment="Left" Padding="13,8" FontSize="12"/>
    </StackPanel>
  </ScrollViewer>
</Window>
